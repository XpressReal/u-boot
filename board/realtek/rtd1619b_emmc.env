bootargs=earlycon=uart8250,mmio32,0x98007800 console=ttyS0,460800 uio_pdrv_genirq.of_id=generic-uio rootfstype=ext4,squashfs rootwait firmware_class.path=/lib/firmware/realtek/rtd1619b/ pd_ignore_unused clk_ignore_unused video=HDMI-A-1:1920x1080@30 console=tty1 loglevel=4

boot_yocto=run setup_devtype; part uuid ${devtype} ${devnum}:2 root_uuid; setenv bootargs "${bootargs} root=PARTUUID=${root_uuid}"; fatload mmc ${devnum}:1 ${bootmaddr} yocto.itb; bootm ${bootmaddr}${bootcfg}
altbootcmd=setenv bootcfg "#rescue"; run boot_yocto
bootdelay=2
initrd_high=0xffffffffffffffff
fdt_high=0xffffffffffffffff
loadaddr=0x03000000
bootmaddr=0x20000000
baudrate=460800
ethact=r8168#0
ethaddr=00:10:20:30:40:50
gatewayip=192.168.100.254
ipaddr=192.168.100.1
netmask=255.255.255.0
serverip=192.168.100.2
bootcmd=run boot_chromium_os || run boot_yocto || run distro_bootcmd || run boot_android || fastboot usb 0

# For Chromium OS on USB/SDMMC/eMMC
script_img=/boot/boot.scr.uimg
script_addr=0x7000000
distro_bootpart=c
devnum=0
# Boot options: USB > SDCard > NVMe > eMMC
setup_emmc=mmc dev 0 && setenv devtype mmc && setenv devnum 0
setup_nvme=if nvme device 0; then setenv devtype nvme; else pci enum && nvme scan && nvme device 0 && setenv devtype nvme; fi
setup_sdcard=mmc dev 1 && setenv devtype mmc && setenv devnum 1
setup_devtype=setenv devtype; if env exists boot_usb; then usb reset; setenv devtype usb; else run setup_sdcard || run setup_nvme || run setup_emmc; fi

load_uimg=run setup_devtype; test -e ${devtype} ${devnum}:${distro_bootpart} ${script_img} && load ${devtype} ${devnum}:${distro_bootpart} ${script_addr} ${script_img}
boot_chromium_os=run load_uimg && source ${script_addr}

# Common distro boot scripts: search "boot.scr" in each bootable partitions and source it to boot
boot_prefixes=/ /boot/
boot_scripts=boot.scr
boot_a_script=load ${devtype} ${devnum}:${distro_bootpart} ${script_addr} ${prefix}${script}; source ${script_addr}

boot_targets=mmc1 mmc0
bootcmd_mmc0=setenv devnum 0; run mmc_boot
bootcmd_mmc1=setenv devnum 1; run mmc_boot

mmc_boot=if mmc dev ${devnum}; then setenv devtype mmc; run scan_dev_for_boot_part; fi

scan_dev_for_boot_part=part list ${devtype} ${devnum} -bootable devplist; env exists devplist || setenv devplist 1; for distro_bootpart in ${devplist}; do if fstype ${devtype} ${devnum}:${distro_bootpart} bootfstype; then run scan_dev_for_boot; fi; done
scan_dev_for_boot=echo Scanning ${devtype} ${devnum}:${distro_bootpart}...; for prefix in ${boot_prefixes}; do run scan_dev_for_scripts; done;
scan_dev_for_scripts=for script in ${boot_scripts}; do if test -e ${devtype} ${devnum}:${distro_bootpart} ${prefix}${script}; then echo Found U-Boot script ${prefix}${script}; run boot_a_script; echo SCRIPT FAILED: continuing...; fi; done

distro_bootcmd=env delete distro_bootpart; for target in ${boot_targets}; do run bootcmd_${target}; done

# fastboot needs these
board=xpressreal_t3
serial#=xpressreal(emmc)

# partition schema for anroid
partitions="name=bootloader,start=4MiB,size=64MiB;name=boot,size=64MiB;name=dtbo,size=8MiB;name=recovery,size=32MiB;name=misc,size=4MiB;name=vbmeta,size=64KiB;name=super,size=3GiB;name=cache,size=256MiB;name=userdata,size=-"

# boot commands for android
setup_android=setenv devnum 0; mmc dev $devnum; setenv bootargs "loglevel=4 androidboot.serialno=xpressreal(emmc) androidboot.boot_devices=soc@0/98000000.rbus/98012000.emmc"
boot_android=run setup_android; if bcb load $devnum misc; then run boot_android_bootloader || run boot_android_recovery || run boot_android_fastbootd || run boot_android_normal; fi
boot_android_bootloader=if bcb test command = bootonce-bootloader; then bcb clear command; bcb store; echo "booting android bootloader"; fastboot usb 0; fi
boot_android_recovery=if bcb test command = boot-recovery; then echo "booting android recovery"; part start mmc $devnum recovery recovery_start; part size mmc $devnum recovery recovery_size; mmc read $bootmaddr $recovery_start $recovery_size; bootm $bootmaddr; fi
boot_android_fastbootd=if bcb test command = boot-fastboot; then echo "booting fastbootd (userspace fastboot)"; part start mmc $devnum recovery fastboot_start; part size mmc $devnum recovery fastboot_size; mmc read $bootmaddr $fastboot_start $fastboot_size; bootm $bootmaddr; fi
boot_android_normal=echo "booting android ..."; part start mmc $devnum boot boot_start; part size mmc $devnum boot boot_size; mmc read $bootmaddr $boot_start $boot_size; bootm $bootmaddr
